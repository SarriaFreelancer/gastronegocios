datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id                 Int               @id @default(autoincrement())
  nombre             String
  slug               String            @unique // e.g. "punto-g", "la-parrilla", "burger-king"
  subdominio         String?           @unique // e.g. "puntog"
  dominio            String?           @unique // custom domain
  eslogan            String?           @default("Antojos Que Conectan")
  descripcion        String?           @db.Text
  logo               String?           @db.Text
  favicon            String?           @db.Text
  bannerHero         String?           @db.Text
  colorPrimario      String            @default("#ffc928")
  colorSecundario    String            @default("#E94B24")
  colorTerciario     String            @default("#1a1a1a")
  colorAcento        String            @default("#ffc928")
  colorFondo         String            @default("#080808")
  colorSuperficie    String            @default("#121212")
  colorTexto         String            @default("#ffffff")
  colorTextoSecundario String          @default("#9ca3af")
  colorBorde         String            @default("#262626")
  colorBoton         String            @default("#ffc928")
  colorBotonTexto    String            @default("#000000")
  colorNavegacion    String            @default("#0a0a0a")
  colorExito         String            @default("#10b981")
  colorAlerta        String            @default("#f59e0b")
  colorError         String            @default("#ef4444")

  // Sistema de Plantillas y Personalización de Secciones
  plantilla          String            @default("plantilla-actual") // "plantilla-actual", "plantilla-minimalista", "plantilla-comercial"
  tituloHero         String?           @db.Text
  subtituloHero      String?           @db.Text
  descripcionHero    String?           @db.Text
  textoBotonHero     String?           @default("Ver la Carta")
  bannerPromocional  String?           @db.Text
  textoPromocional   String?           @db.Text
  tituloSeccionMenu  String?           @default("Nuestra Carta")
  tituloSeccionDestacados String?      @default("Los Más Pedidos")
  mostrarHero        Boolean           @default(true)
  mostrarCategorias  Boolean           @default(true)
  mostrarDestacados  Boolean           @default(true)
  mostrarPromociones Boolean           @default(true)
  mostrarResenas     Boolean           @default(true)
  mostrarHorarios    Boolean           @default(true)
  ordenSecciones     String?           @db.Text // JSON string: ["hero", "categorias", "destacados", "promociones", "menu", "resenas"]
  horarioAtencion    String?           @default("Lunes a Domingo: 12:00 m. a 11:30 p.m.")
  redesSociales      String?           @db.Text // JSON string: { facebook, instagram, tiktok, youtube }

  // Configuración de Estilo Avanzado
  tipografia         String            @default("system") // "system", "inter", "poppins", "montserrat", "playfair"
  radioBordes        String            @default("rounded-2xl") // "rounded-none", "rounded-lg", "rounded-2xl", "rounded-full"
  estiloTarjetas     String            @default("card-glass") // "card-glass", "card-solid", "card-bordered"
  columnasMenu       Int               @default(3) // 2, 3, 4
  aparienciaMenu     String            @default("clasico") // "clasico" (Opción A: Actual), "lateral" (Opción B: Menú lateral con barra de categorías)
  aparienciaAdmin    String            @default("lateral") // "superior" (Barra horizontal arriba), "lateral" (Barra lateral moderna con módulos colapsables)

  // Políticas de Inventario y Módulos
  politicaStockNegativo String          @default("BLOQUEAR") // "BLOQUEAR", "PERMITIR_NEGATIVO"
  diasAnticipacionVencimiento Int      @default(7) // Días para alertar lotes próximos a vencer
  modulosHabilitados String?           @db.Text // JSON string: ["dashboard", "ventas", "productos", "inventario", "recetas", "compras", "proveedores", "clientes", "usuarios", "caja", "gastos", "reportes", "analitica", "menu_digital", "importaciones"]

  // Sistema de SEO Técnico y Posicionamiento
  seoTitulo          String?           @db.Text
  seoDescripcion    String?           @db.Text
  seoKeywords        String?           @db.Text
  seoTipoNegocio     String            @default("Restaurant") // Restaurant, FastFoodRestaurant, BarOrPub, CafeOrCoffeeShop
  seoImagenCompartir String?           @db.Text
  seoUrlCanonica     String?           @db.Text
  googleSearchConsoleCode String?      @db.Text
  googleAnalyticsId  String?
  telefonoWhatsapp   String?           @default("3229088736")
  mensajeWhatsappDefault String?       @default("¡Hola! Quiero hacer un pedido por la web.")
  email              String?           @default("contacto@puntog.com")
  correoRemitente    String?           @default("pedidos@puntog.com")
  correoDestinatario String?           @default("novedades@puntog.com")
  instagram          String?
  direccionCentral   String?           @default("Calle 9 # 45-12, Granada, Cali")
  ciudad             String            @default("Cali")
  costoDomicilioBase Float             @default(5000)
  propinaSugeridaPct Float             @default(10)
  plan               String            @default("Pro") // "Basico", "Pro", "Enterprise"
  activo             Boolean           @default(true)
  mostrarEnLanding   Boolean           @default(true)
  fechaVencimiento   DateTime?
  limiteSedes        Int               @default(3)
  limiteProductos    Int               @default(100)
  limiteUsuarios     Int               @default(10)
  diasGracia         Int               @default(5)
  estadoLicencia     String            @default("ACTIVA") // "ACTIVA", "POR_VENCER", "VENCIDA", "SUSPENDIDA"

  // Servidor de Base de Datos Dedicada / Migración Monolítica (Exclusivo Superadmin)
  databaseType       String            @default("SHARED") // "SHARED", "DEDICATED"
  dbHost             String?           // Ej: "192.168.1.50" o "db-puntog.aws.com"
  dbPort             Int?              @default(3306)
  dbName             String?           // Ej: "restaurant_masterhamburguesas"
  dbUser             String?           // Ej: "dbuser_master"
  dbPassword         String?           // Clave del servidor dedicado
  dbConnectionUrl    String?           @db.Text
  dbStatus           String?           @default("COMPARTIDA") // "COMPARTIDA", "MIGRANDO", "DEDICADA_ACTIVA"
  migratedAt         DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  users              User[]
  branches           Branch[]
  categories         Category[]
  products           Product[]
  tables             RestaurantTable[]
  orders             Order[]
  invoices           Invoice[]
  addons             ProductAddon[]
  shifts             CashShift[]
  reviews            Review[]
  supplies           Supply[]
  suppliers          Supplier[]
  recipes            Recipe[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  customers          Customer[]
  roles              Role[]

  @@map("restaurants")
}

model User {
  id           Int         @id @default(autoincrement())
  nombre       String
  email        String      @unique
  password     String      @default("admin123")
  rol          String      @default("Cajero") // Superadmin, Administrador, Supervisor, Cajero, Cocinero, Mesero
  permisos     String?     @db.Text // JSON con matriz de permisos y capacidades especiales
  estado       String      @default("Activo") // Activo, Inactivo
  branchId     Int?
  sedeId       Int?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  roleId       Int?
  customRole   Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

model Role {
  id           Int         @id @default(autoincrement())
  nombre       String      // Propietario, Administrador, Gerente, Cajero, Mesero, Cocinero, Encargado de inventario, Auxiliar, Auditor
  descripcion  String?
  permisos     String      @db.Text // JSON con matriz de permisos por módulo
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users        User[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("roles")
}

model Branch {
  id           Int               @id @default(autoincrement())
  nombre       String            // e.g. "Sede Granada (Principal)", "Sede Ciudad Jardín"
  slug         String            @unique // e.g. "granada", "ciudad-jardin"
  direccion    String?           @db.Text
  telefono     String?
  ciudad       String            @default("Cali")
  activo       Boolean           @default(true)
  restaurantId Int?
  restaurant   Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  orders             Order[]
  invoices           Invoice[]
  tables             RestaurantTable[]
  shifts             CashShift[]
  supplies           Supply[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]

  @@map("branches")
}

model Category {
  id           Int         @id @default(autoincrement())
  nombre       String
  slug         String      @unique
  descripcion  String?     @db.Text
  icono        String      @default("Utensils")
  imagen       String?     @db.Text
  orden        Int         @default(0)
  activo       Boolean     @default(true)
  parentId     Int?        // null = Categoría Principal; not null = Subcategoría
  parent       Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]  @relation("CategoryHierarchy")
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]   @relation("ProductCategory")
  subProducts  Product[]   @relation("ProductSubcategory")

  @@map("categories")
}

model Product {
  id             Int         @id @default(autoincrement())
  nombre         String
  slug           String      @unique
  descripcion    String      @db.Text
  precio         Float
  imagen         String      @db.Text
  categoriaId    Int
  categoria      Category    @relation("ProductCategory", fields: [categoriaId], references: [id], onDelete: Cascade)
  subcategoriaId Int?
  subcategoria   Category?   @relation("ProductSubcategory", fields: [subcategoriaId], references: [id], onDelete: SetNull)
  etiqueta       String?     // MÁS VENDIDO, NUEVO, RECOMENDADO
  disponibilidad Boolean     @default(true)
  stock          Int?        // Cantidad disponible en inventario
  stockMinimo    Int?        @default(5) // Alerta de stock bajo
  controlarStock Boolean     @default(false)
  costo          Float?      // Costo de insumos / Food Cost
  codigoBarras   String?     // Código EAN / Código de barras opcional
  sku            String?     // Código SKU interno opcional
  orden          Int         @default(0)
  restaurantId   Int?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  recipe         Recipe?

  @@map("products")
}

model RestaurantTable {
  id                Int         @id @default(autoincrement())
  numero            String      @unique // e.g. "Mesa 1", "Mesa 2", "Barra 1"
  capacidad         Int         @default(4)
  estado            String      @default("Libre") // Libre, Ocupada, Cuenta_Pedida, Reservada
  ubicacion         String?     // Salon Principal, Terraza, Barra, VIP
  notas             String?     @db.Text
  branchId          Int?
  sedeId            Int?
  branch            Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId      Int?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  llamandoMesero    Boolean     @default(false)
  llamadoEn         DateTime?
  solicitudCuenta   Boolean     @default(false)
  solicitudCuentaEn DateTime?
  metodoPagoCuenta  String?     // Efectivo, Nequi, Datáfono
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orders            Order[]

  @@map("restaurant_tables")
}

model Order {
  id            Int              @id @default(autoincrement())
  codigo        String           @unique // e.g. "PG-1045"
  cliente       String
  telefono      String
  tipo          String           @default("domicilio") // domicilio, recoger, mesa
  mesaId        Int?
  mesa          RestaurantTable? @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  numeroMesa    String?          // Direct snapshot if mesaId deleted or manual
  direccion     String?          @db.Text
  barrio        String?
  subtotal      Float            @default(0)
  propina       Float            @default(0) // Propinas voluntarias
  costoEnvio    Float            @default(0)
  total         Float            @default(0)
  estado        String           @default("Pendiente") // Pendiente, En Preparación, Listo, Despachado, Entregado, Cancelado
  metodoPago    String           @default("Efectivo") // Efectivo, Nequi, Daviplata, Datáfono, Transferencia
  notasCliente  String?          @db.Text // Comentarios del pedido ("sin cebolla, salsas aparte", etc.)
  repartidor    String?          // Nombre del domiciliario asignado e.g. "Carlos Moto 1"
  repartidorTel String?          // Teléfono del domiciliario
  branchId      Int?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sedeNombre    String?          // Snapshot nombre sede e.g. "Sede Granada"
  customerId    Int?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  restaurantId  Int?
  restaurant    Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         OrderItem[]
  reviews       Review[]
  cuentaDividida Boolean         @default(false)
  numFacturas    Int             @default(1)
  invoices       Invoice[]

  @@index([createdAt])
  @@index([tipo])
  @@index([estado])
  @@index([branchId])
  @@index([customerId])
  @@index([restaurantId])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nombre      String
  precio      Float
  cantidad    Int      @default(1)
  notas       String?  @db.Text
  adicionales String?  @db.Text // JSON string: [{ id, nombre, precio }]
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model Invoice {
  id            Int          @id @default(autoincrement())
  numeroFactura String       @unique // e.g. "FAC-PG-1045" o "FAC-PG-1045-1"
  orderId       Int?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cliente       String
  telefono      String?
  tipo          String       @default("mesa") // mesa, domicilio, recoger
  numeroMesa    String?
  subtotal      Float        @default(0)
  propina       Float        @default(0)
  costoEnvio    Float        @default(0)
  total         Float        @default(0)
  metodoPago    String       @default("Efectivo") // Efectivo, Nequi, Daviplata, Datáfono, Transferencia
  estado        String       @default("Pagada") // Pagada, Anulada, Pendiente
  itemsJson     String       @db.Text // [{ nombre, precio, cantidad, notas, adicionales }]
  esDividida    Boolean      @default(false)
  dinerNombre   String?      // e.g. "Comensal 1", "Juan", etc.
  dinerIndex    Int?         @default(1)
  totalDiners   Int?         @default(1)
  notas         String?      @db.Text
  cajero        String?      @default("Mesero / Caja")
  branchId      Int?
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId  Int?
  restaurant    Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId])
  @@index([branchId])
  @@index([restaurantId])
  @@index([createdAt])
  @@map("invoices")
}

model ProductAddon {
  id           Int         @id @default(autoincrement())
  nombre       String
  precio       Float       @default(0)
  categoria    String      @default("Toppings") // Toppings, Salsas, Adiciones, Acompañamientos
  activo       Boolean     @default(true)
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("product_addons")
}

model CashShift {
  id             Int           @id @default(autoincrement())
  cajero         String        @default("Admin")
  fecha          DateTime      @default(now())
  baseInicial    Float         @default(0)
  ventasEfectivo Float         @default(0)
  ventasTransfer Float         @default(0) // Nequi/Daviplata
  ventasDatafono Float         @default(0) // Tarjetas
  propinasTotal  Float         @default(0)
  totalVentas    Float         @default(0)
  totalEgresos   Float         @default(0)
  efectivoReal   Float?
  diferencia     Float?
  notas          String?       @db.Text
  estado         String        @default("Abierto") // Abierto, Cerrado
  cerradoEn      DateTime?
  branchId       Int?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId   Int?
  restaurant     Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  egresos        CashExpense[]

  @@map("cash_shifts")
}

model CashExpense {
  id          Int       @id @default(autoincrement())
  shiftId     Int
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Float
  categoria   String    @default("Insumos") // Insumos, Domicilios, Personal, Varios
  creadoPor   String?   @default("Admin")
  createdAt   DateTime  @default(now())

  @@map("cash_expenses")
}

model Review {
  id            Int         @id @default(autoincrement())
  orderId       Int?
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  mesaNumero    String?     // e.g. "Mesa 4"
  clienteNombre String
  calificacion  Int         @default(5) // 1 a 5 estrellas
  tipoVisita    String      @default("En Sitio / Mesa") // En Sitio / Mesa, Domicilio, Para Llevar
  comentario    String      @db.Text
  respuesta     String?     @db.Text
  publicado     Boolean     @default(true)
  restaurantId  Int?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("reviews")
}

model RestaurantConfig {
  id                 Int      @id @default(autoincrement())
  nombre             String   @default("PUNTO G")
  eslogan            String   @default("ANTOJOS QUE CONECTAN")
  telefonoWhatsapp   String   @default("3229088736")
  mensajeWhatsappDefault String? @default("¡Hola! Quiero hacer un pedido por la web.")
  email              String?  @default("contacto@puntog.com")
  correoRemitente    String?  @default("pedidos@puntog.com")
  correoDestinatario String?  @default("novedades@puntog.com")
  direccion          String   @default("Calle 9 # 45-12, Barrio Granada, Cali")
  horario            String   @default("Lunes a Domingo: 12:00 m. a 11:30 p.m.")
  costoDomicilioBase Float    @default(5000)
  propinaSugeridaPct Float    @default(10)
  urlBaseSitio       String   @default("http://localhost:3005")
  updatedAt          DateTime @updatedAt

  @@map("restaurant_config")
}

// ==========================================
// MÓDULO ERP: PROVEEDORES
// ==========================================
model Supplier {
  id           Int         @id @default(autoincrement())
  nombre       String
  nit          String?
  contacto     String?
  telefono     String?
  email        String?
  direccion    String?     @db.Text
  ciudad       String?     @default("Cali")
  categoria    String?     @default("General") // Carnes, Abarrotes, Frutas y Verduras, Lácteos, Empaques
  activo       Boolean     @default(true)
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplies     Supply[]
  purchases    Purchase[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([restaurantId])
  @@map("suppliers")
}

// ==========================================
// MÓDULO ERP: MATERIAS PRIMAS E INSUMOS
// ==========================================
model Supply {
  id               Int                 @id @default(autoincrement())
  codigoInterno    String              // e.g. "MP-001"
  codigoBarras     String?             // Código EAN opcional
  nombre           String              // e.g. "Tomate Chonto", "Carne de Res Molida"
  descripcion      String?             @db.Text
  categoria        String              @default("General") // Verduras, Carnes, Lácteos, Panadería, Salsas, Empaques
  unidadMedida     String              @default("g") // Unidad de consumo/receta: g, kg, ml, l, und, porc, paq, caja, lb
  unidadCompra     String?             @default("kg") // Unidad en la que compra al proveedor
  factorConversion Float               @default(1.0) // 1 unidadCompra = X unidadMedida (ej: 1 kg = 1000 g)
  stockActual      Float               @default(0) // Existencia actual en unidadMedida
  stockMinimo      Float               @default(0) // Umbral alerta de stock bajo
  stockMaximo      Float               @default(0) // Umbral alerta exceso de stock
  costoUnitario    Float               @default(0) // Costo por unidadMedida base (ej: $5 por gramo)
  costoPromedio    Float               @default(0) // Costo promedio ponderado
  proveedorId      Int?
  proveedor        Supplier?           @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  restaurantId     Int
  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId         Int?
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fechaVencimiento DateTime?           // Próximo vencimiento
  lote             String?             // Lote actual
  estado           String              @default("Activo") // Activo, Inactivo, Agotado
  observaciones    String?             @db.Text
  movements        InventoryMovement[]
  recipeItems      RecipeItem[]
  purchaseItems    PurchaseItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([codigoInterno])
  @@map("supplies")
}

// ==========================================
// MÓDULO ERP: KARDEX Y MOVIMIENTOS DE INVENTARIO
// ==========================================
model InventoryMovement {
  id                 Int         @id @default(autoincrement())
  supplyId           Int
  supply             Supply      @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  tipoMovimiento     String      // ENTRADA_COMPRA, SALIDA_VENTA, SALIDA_PREPARACION, AJUSTE_POSITIVO, AJUSTE_NEGATIVO, MERMA, DESPERDICIO, DEVOLUCION, TRASLADO, CORRECCION
  cantidad           Float       // En unidadMedida de la materia prima
  unidad             String
  stockAnterior      Float
  stockResultante    Float
  costoUnitario      Float       @default(0)
  costoTotal         Float       @default(0)
  esNegativo         Boolean     @default(false) // Flag si operó con stock negativo
  autorizadoPor      String?     // Usuario que autorizó la operación en stock negativo o ajuste
  motivo             String?     @db.Text
  referencia         String?     // e.g. "ORD-PG-1045", "FAC-001", "AJUSTE-MANUAL"
  usuarioResponsable String?     @default("Sistema")
  restaurantId       Int
  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId           Int?
  branch             Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())

  @@index([supplyId])
  @@index([restaurantId])
  @@index([branchId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ==========================================
// MÓDULO ERP: RECETAS Y FICHAS TÉCNICAS
// ==========================================
model Recipe {
  id                Int          @id @default(autoincrement())
  nombre            String       // e.g. "Receta Hamburguesa Especial"
  productId         Int          @unique
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  porciones         Float        @default(1)
  rendimiento       Float        @default(100) // %
  tiempoPreparacion Int?         @default(15) // minutos
  costoTotal        Float        @default(0) // Suma calculada de costos de insumos
  costoPorcion      Float        @default(0) // costoTotal / porciones
  margenUtilidad    Float?       // Margen bruto porcentual estimado vs precio venta
  instrucciones     String?      @db.Text
  observaciones     String?      @db.Text
  activo            Boolean      @default(true)
  restaurantId      Int
  restaurant        Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items             RecipeItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([restaurantId])
  @@map("recipes")
}

model RecipeItem {
  id                     Int     @id @default(autoincrement())
  recipeId               Int
  recipe                 Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supplyId               Int
  supply                 Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  cantidad               Float   // Cantidad requerida de insumo
  unidad                 String  // Unidad de la receta (g, ml, und, etc.)
  costoUnitarioCalculado Float   @default(0)
  costoSubtotal          Float   @default(0)
  notas                  String?

  @@index([recipeId])
  @@index([supplyId])
  @@map("recipe_items")
}

// ==========================================
// MÓDULO ERP: COMPRAS Y ENTRADAS
// ==========================================
model Purchase {
  id             Int            @id @default(autoincrement())
  numeroFactura  String         // e.g. "FAC-PROV-987"
  supplierId     Int?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  fecha          DateTime       @default(now())
  total          Float          @default(0)
  estado         String         @default("Recibido") // Recibido, Pendiente, Anulado
  metodoPago     String         @default("Efectivo") // Efectivo, Transferencia, Crédito
  observaciones  String?        @db.Text
  registradoPor  String?        @default("Admin")
  restaurantId   Int
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId       Int?
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([restaurantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id               Int       @id @default(autoincrement())
  purchaseId       Int
  purchase         Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplyId         Int
  supply           Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  cantidad         Float     // Cantidad comprada
  unidad           String    // Unidad de compra o base
  precioUnitario   Float     // Precio por unidad
  subtotal         Float
  lote             String?
  fechaVencimiento DateTime?

  @@index([purchaseId])
  @@index([supplyId])
  @@map("purchase_items")
}

// ==========================================
// MÓDULO ERP: CLIENTES DEL RESTAURANTE
// ==========================================
model Customer {
  id            Int         @id @default(autoincrement())
  nombre        String
  documento     String?     // Cédula o NIT
  telefono      String?
  email         String?
  password      String?     // Contraseña para inicio de sesión del cliente
  direccion     String?     @db.Text
  ciudad        String?     @default("Cali")
  barrio        String?
  totalComprado Float       @default(0)
  totalPedidos  Int         @default(0)
  ultimaCompra  DateTime?
  notas         String?     @db.Text
  activo        Boolean     @default(true)
  restaurantId  Int
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([restaurantId])
  @@index([telefono])
  @@map("customers")
}

// ==========================================
// PLANES Y LICENCIAS SAAS (LANDING & SUPERADMIN)
// ==========================================
model SaasPlan {
  id                  Int      @id @default(autoincrement())
  codigo              String   @unique // "Basico", "Pro", "Enterprise"
  nombre              String
  subtitulo           String   @default("")
  emoji               String   @default("🚀")
  precioMensual       Float    @default(29990)
  precioAnual         Float    @default(299900)
  moneda              String   @default("COP")
  badgeTexto          String?
  destacado           Boolean  @default(false)
  caracteristicasJson String   @db.Text
  limiteSedes         Int      @default(1)
  limiteProductos     Int      @default(100)
  limiteUsuarios      Int      @default(10)
  ctaTexto            String   @default("Comenzar Ahora")
  tipoAccion          String   @default("registro")
  activo              Boolean  @default(true)
  orden               Int      @default(1)
  updatedAt           DateTime @updatedAt

  @@map("saas_plans")
}

// ==========================================
// CUPONES DE DESCUENTO POR RESTAURANTE
// ==========================================
model Coupon {
  id               Int       @id @default(autoincrement())
  codigo           String
  descripcion      String    @default("")
  tipoDescuento    String    @default("porcentaje") // "porcentaje", "fijo", "envio"
  valor            Float     @default(10)
  montoMinimo      Float     @default(0)
  usoMaximo        Int       @default(0) // 0 = ilimitado
  usosActuales     Int       @default(0)
  fechaInicio      DateTime?
  fechaFin         DateTime?
  activo           Boolean   @default(true)
  mostrarEnCarrito Boolean   @default(true)
  soloDomicilio    Boolean   @default(false)
  restaurantId     Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([restaurantId, codigo])
  @@index([restaurantId])
  @@map("coupons")
}
