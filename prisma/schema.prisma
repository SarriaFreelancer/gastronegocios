datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id                 Int               @id @default(autoincrement())
  nombre             String
  slug               String            @unique // e.g. "punto-g", "la-parrilla", "burger-king"
  subdominio         String?           @unique // e.g. "puntog"
  dominio            String?           @unique // custom domain
  eslogan            String?           @default("Antojos Que Conectan")
  descripcion        String?           @db.Text
  logo               String?           @db.Text
  favicon            String?           @db.Text
  bannerHero         String?           @db.Text
  colorPrimario      String            @default("#ffc928")
  colorSecundario    String            @default("#E94B24")
  colorTerciario     String            @default("#1a1a1a")
  colorAcento        String            @default("#ffc928")
  colorFondo         String            @default("#080808")
  colorSuperficie    String            @default("#121212")
  colorTexto         String            @default("#ffffff")
  colorTextoSecundario String          @default("#9ca3af")
  colorBorde         String            @default("#262626")
  colorBoton         String            @default("#ffc928")
  colorBotonTexto    String            @default("#000000")
  colorNavegacion    String            @default("#0a0a0a")
  colorExito         String            @default("#10b981")
  colorAlerta        String            @default("#f59e0b")
  colorError         String            @default("#ef4444")

  // Sistema de Plantillas y Personalización de Secciones
  plantilla          String            @default("plantilla-actual") // "plantilla-actual", "plantilla-minimalista", "plantilla-comercial"
  tituloHero         String?           @db.Text
  subtituloHero      String?           @db.Text
  descripcionHero    String?           @db.Text
  textoBotonHero     String?           @default("Ver la Carta")
  bannerPromocional  String?           @db.Text
  textoPromocional   String?           @db.Text
  tituloSeccionMenu  String?           @default("Nuestra Carta")
  tituloSeccionDestacados String?      @default("Los Más Pedidos")
  mostrarHero        Boolean           @default(true)
  mostrarCategorias  Boolean           @default(true)
  mostrarDestacados  Boolean           @default(true)
  mostrarPromociones Boolean           @default(true)
  mostrarResenas     Boolean           @default(true)
  mostrarHorarios    Boolean           @default(true)
  ordenSecciones     String?           @db.Text // JSON string: ["hero", "categorias", "destacados", "promociones", "menu", "resenas"]
  horarioAtencion    String?           @default("Lunes a Domingo: 12:00 m. a 11:30 p.m.")
  redesSociales      String?           @db.Text // JSON string: { facebook, instagram, tiktok, youtube }

  // Configuración de Estilo Avanzado
  tipografia         String            @default("system") // "system", "inter", "poppins", "montserrat", "playfair"
  radioBordes        String            @default("rounded-2xl") // "rounded-none", "rounded-lg", "rounded-2xl", "rounded-full"
  estiloTarjetas     String            @default("card-glass") // "card-glass", "card-solid", "card-bordered"
  columnasMenu       Int               @default(3) // 2, 3, 4

  // Sistema de SEO Técnico y Posicionamiento
  seoTitulo          String?           @db.Text
  seoDescripcion    String?           @db.Text
  seoKeywords        String?           @db.Text
  seoTipoNegocio     String            @default("Restaurant") // Restaurant, FastFoodRestaurant, BarOrPub, CafeOrCoffeeShop
  seoImagenCompartir String?           @db.Text
  seoUrlCanonica     String?           @db.Text
  googleSearchConsoleCode String?      @db.Text
  googleAnalyticsId  String?
  telefonoWhatsapp   String?           @default("3229088736")
  instagram          String?
  direccionCentral   String?           @default("Calle 9 # 45-12, Granada, Cali")
  ciudad             String            @default("Cali")
  costoDomicilioBase Float             @default(5000)
  propinaSugeridaPct Float             @default(10)
  plan               String            @default("Pro") // "Basico", "Pro", "Enterprise"
  activo             Boolean           @default(true)

  // Servidor de Base de Datos Dedicada / Migración Monolítica (Exclusivo Superadmin)
  databaseType       String            @default("SHARED") // "SHARED", "DEDICATED"
  dbHost             String?           // Ej: "192.168.1.50" o "db-puntog.aws.com"
  dbPort             Int?              @default(3306)
  dbName             String?           // Ej: "restaurant_masterhamburguesas"
  dbUser             String?           // Ej: "dbuser_master"
  dbPassword         String?           // Clave del servidor dedicado
  dbConnectionUrl    String?           @db.Text
  dbStatus           String?           @default("COMPARTIDA") // "COMPARTIDA", "MIGRANDO", "DEDICADA_ACTIVA"
  migratedAt         DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  users              User[]
  branches           Branch[]
  categories         Category[]
  products           Product[]
  tables             RestaurantTable[]
  orders             Order[]
  addons             ProductAddon[]
  shifts             CashShift[]
  reviews            Review[]

  @@map("restaurants")
}

model User {
  id           Int         @id @default(autoincrement())
  nombre       String
  email        String      @unique
  password     String      @default("admin123")
  rol          String      @default("Cajero") // Superadmin, Administrador, Supervisor, Cajero, Cocinero, Mesero
  estado       String      @default("Activo") // Activo, Inactivo
  branchId     Int?
  sedeId       Int?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

model Branch {
  id           Int               @id @default(autoincrement())
  nombre       String            // e.g. "Sede Granada (Principal)", "Sede Ciudad Jardín"
  slug         String            @unique // e.g. "granada", "ciudad-jardin"
  direccion    String?           @db.Text
  telefono     String?
  ciudad       String            @default("Cali")
  activo       Boolean           @default(true)
  restaurantId Int?
  restaurant   Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  orders       Order[]
  tables       RestaurantTable[]
  shifts       CashShift[]

  @@map("branches")
}

model Category {
  id           Int         @id @default(autoincrement())
  nombre       String
  slug         String      @unique
  descripcion  String?     @db.Text
  icono        String      @default("Utensils")
  imagen       String?     @db.Text
  orden        Int         @default(0)
  activo       Boolean     @default(true)
  parentId     Int?        // null = Categoría Principal; not null = Subcategoría
  parent       Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]  @relation("CategoryHierarchy")
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]   @relation("ProductCategory")
  subProducts  Product[]   @relation("ProductSubcategory")

  @@map("categories")
}

model Product {
  id             Int         @id @default(autoincrement())
  nombre         String
  slug           String      @unique
  descripcion    String      @db.Text
  precio         Float
  imagen         String      @db.Text
  categoriaId    Int
  categoria      Category    @relation("ProductCategory", fields: [categoriaId], references: [id], onDelete: Cascade)
  subcategoriaId Int?
  subcategoria   Category?   @relation("ProductSubcategory", fields: [subcategoriaId], references: [id], onDelete: SetNull)
  etiqueta       String?     // MÁS VENDIDO, NUEVO, RECOMENDADO
  disponibilidad Boolean     @default(true)
  stock          Int?        // Cantidad disponible en inventario
  stockMinimo    Int?        @default(5) // Alerta de stock bajo
  controlarStock Boolean     @default(false)
  costo          Float?      // Costo de insumos / Food Cost
  orden          Int         @default(0)
  restaurantId   Int?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@map("products")
}

model RestaurantTable {
  id                Int         @id @default(autoincrement())
  numero            String      @unique // e.g. "Mesa 1", "Mesa 2", "Barra 1"
  capacidad         Int         @default(4)
  estado            String      @default("Libre") // Libre, Ocupada, Cuenta_Pedida, Reservada
  ubicacion         String?     // Salon Principal, Terraza, Barra, VIP
  notas             String?     @db.Text
  branchId          Int?
  sedeId            Int?
  branch            Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId      Int?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  llamandoMesero    Boolean     @default(false)
  llamadoEn         DateTime?
  solicitudCuenta   Boolean     @default(false)
  solicitudCuentaEn DateTime?
  metodoPagoCuenta  String?     // Efectivo, Nequi, Datáfono
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orders            Order[]

  @@map("restaurant_tables")
}

model Order {
  id            Int              @id @default(autoincrement())
  codigo        String           @unique // e.g. "PG-1045"
  cliente       String
  telefono      String
  tipo          String           @default("domicilio") // domicilio, recoger, mesa
  mesaId        Int?
  mesa          RestaurantTable? @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  numeroMesa    String?          // Direct snapshot if mesaId deleted or manual
  direccion     String?          @db.Text
  barrio        String?
  subtotal      Float            @default(0)
  propina       Float            @default(0) // Propinas voluntarias
  costoEnvio    Float            @default(0)
  total         Float            @default(0)
  estado        String           @default("Pendiente") // Pendiente, En Preparación, Listo, Despachado, Entregado, Cancelado
  metodoPago    String           @default("Efectivo") // Efectivo, Nequi, Daviplata, Datáfono, Transferencia
  notasCliente  String?          @db.Text // Comentarios del pedido ("sin cebolla, salsas aparte", etc.)
  repartidor    String?          // Nombre del domiciliario asignado e.g. "Carlos Moto 1"
  repartidorTel String?          // Teléfono del domiciliario
  branchId      Int?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sedeNombre    String?          // Snapshot nombre sede e.g. "Sede Granada"
  restaurantId  Int?
  restaurant    Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         OrderItem[]
  reviews       Review[]

  @@index([createdAt])
  @@index([tipo])
  @@index([estado])
  @@index([branchId])
  @@index([restaurantId])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nombre      String
  precio      Float
  cantidad    Int      @default(1)
  notas       String?  @db.Text
  adicionales String?  @db.Text // JSON string: [{ id, nombre, precio }]
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model ProductAddon {
  id           Int         @id @default(autoincrement())
  nombre       String
  precio       Float       @default(0)
  categoria    String      @default("Toppings") // Toppings, Salsas, Adiciones, Acompañamientos
  activo       Boolean     @default(true)
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("product_addons")
}

model CashShift {
  id             Int           @id @default(autoincrement())
  cajero         String        @default("Admin")
  fecha          DateTime      @default(now())
  baseInicial    Float         @default(0)
  ventasEfectivo Float         @default(0)
  ventasTransfer Float         @default(0) // Nequi/Daviplata
  ventasDatafono Float         @default(0) // Tarjetas
  propinasTotal  Float         @default(0)
  totalVentas    Float         @default(0)
  totalEgresos   Float         @default(0)
  efectivoReal   Float?
  diferencia     Float?
  notas          String?       @db.Text
  estado         String        @default("Abierto") // Abierto, Cerrado
  cerradoEn      DateTime?
  branchId       Int?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  restaurantId   Int?
  restaurant     Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  egresos        CashExpense[]

  @@map("cash_shifts")
}

model CashExpense {
  id          Int       @id @default(autoincrement())
  shiftId     Int
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Float
  categoria   String    @default("Insumos") // Insumos, Domicilios, Personal, Varios
  creadoPor   String?   @default("Admin")
  createdAt   DateTime  @default(now())

  @@map("cash_expenses")
}

model Review {
  id            Int         @id @default(autoincrement())
  orderId       Int?
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  mesaNumero    String?     // e.g. "Mesa 4"
  clienteNombre String
  calificacion  Int         @default(5) // 1 a 5 estrellas
  tipoVisita    String      @default("En Sitio / Mesa") // En Sitio / Mesa, Domicilio, Para Llevar
  comentario    String      @db.Text
  respuesta     String?     @db.Text
  publicado     Boolean     @default(true)
  restaurantId  Int?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("reviews")
}

model RestaurantConfig {
  id                 Int      @id @default(autoincrement())
  nombre             String   @default("PUNTO G")
  eslogan            String   @default("ANTOJOS QUE CONECTAN")
  telefonoWhatsapp   String   @default("3229088736")
  direccion          String   @default("Calle 9 # 45-12, Barrio Granada, Cali")
  horario            String   @default("Lunes a Domingo: 12:00 m. a 11:30 p.m.")
  costoDomicilioBase Float    @default(5000)
  propinaSugeridaPct Float    @default(10)
  urlBaseSitio       String   @default("http://localhost:3005")
  updatedAt          DateTime @updatedAt

  @@map("restaurant_config")
}
